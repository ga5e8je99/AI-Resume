# ==============================================================================
# JobMatch AI - Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# DO NOT commit real secrets, API keys, or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# MongoDB Connection String:
# - Local MongoDB: mongodb://127.0.0.1:27017/jobmatch
# - MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jobmatch?retryWrites=true&w=majority
# - Fallback: If MONGODB_URI is unreachable or not configured, the system automatically
#   falls back to the local file datastore (.data/db.json) for zero-setup development.
MONGODB_URI=mongodb://127.0.0.1:27017/jobmatch

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT authentication tokens (min 32 characters recommended)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_characters

# Secret key required for administrative access and maintenance routes (/admin, /api/admin/*)
ADMIN_KEY=replace_with_a_strong_admin_key_for_privileged_operations

# Comma-separated list of administrative email addresses with elevated permissions
ADMIN_EMAILS=admin@jobmatch.ai,lead@jobmatch.ai

# ------------------------------------------------------------------------------
# 3. Application URLs & Public Endpoints
# ------------------------------------------------------------------------------
# Canonical application base URL (used for CORS validation, CSRF origin verification, and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL for API requests originating from the client-side browser
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ------------------------------------------------------------------------------
# 4. AI Provider Integration (Cover Letter Generator & ATS AI Engine)
# ------------------------------------------------------------------------------
# Optional: OpenAI API Key or compatible LLM provider key (OpenAI, Azure OpenAI, Groq, Ollama, etc.)
# If left empty, or if an external network failure/rate-limit occurs, the application
# gracefully and instantaneously activates the built-in algorithmic ATS synthesizer engine
# (zero external dependencies, zero latency spikes, zero hallucination risk).
OPENAI_API_KEY=

# Target model name (default: gpt-4o-mini for optimal quality-to-latency balance)
OPENAI_MODEL=gpt-4o-mini

# Base URL for OpenAI-compatible endpoints (useful for private proxies, LiteLLM, or self-hosted models)
OPENAI_BASE_URL=https://api.openai.com/v1

# Maximum duration in milliseconds to wait for external AI response before fallback (default: 15000ms = 15s)
AI_REQUEST_TIMEOUT_MS=15000

# Maximum number of retry attempts on transient network or 429 rate limit errors (default: 2)
AI_MAX_RETRIES=2

# Master toggle to enable or disable external AI calls (default: true; set to false to force local ATS engine)
AI_PROVIDER_ENABLED=true

# ------------------------------------------------------------------------------
# 5. Rate Limiting & Resource Protection (Sliding Window Log)
# ------------------------------------------------------------------------------
# The system enforces built-in sliding window rate limiting on API routes:
# - POST /api/cover-letter/generate      : 40 requests/min
# - POST /api/cover-letter/extract-keywords: 60 requests/min
# - GET  /api/cover-letters              : 100 requests/min
# - POST /api/cover-letters (create)     : 60 requests/min
# Standard headers returned: X-RateLimit-Limit, X-RateLimit-Remaining, X-RateLimit-Reset, Retry-After (on 429).
