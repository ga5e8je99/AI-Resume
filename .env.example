# ==============================================================================
# JobMatch AI - Environment Configuration Template
# ==============================================================================
# Instructions:
# - Local Development: Copy this file to .env.local (`cp .env.example .env.local`)
# - Vercel Production: Add these variables in Project Settings > Environment Variables
# - SECURITY: Never commit real credentials or .env.local to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Required in Production on Vercel)
# ------------------------------------------------------------------------------
# MongoDB Connection String:
# - Vercel / Production: MongoDB Atlas connection string (M0 Free Tier or higher)
#   Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jobmatch?retryWrites=true&w=majority
# - Local Development: Defaults to mongodb://127.0.0.1:27017/jobmatch or local .data fallback
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jobmatch?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Authentication & Security (Required)
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying user session JWT tokens.
# Must be at least 32 random characters in production. (e.g. generate via `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_characters

# Secret key required for administrative access and dashboard maintenance (/admin, /api/admin/*)
ADMIN_KEY=replace_with_a_strong_admin_key_for_privileged_operations

# Comma-separated list of administrative email accounts permitted to access the admin portal
ADMIN_EMAILS=admin@jobmatch.ai,lead@jobmatch.ai

# ------------------------------------------------------------------------------
# 3. Application URLs & Public Endpoints (Required in Production)
# ------------------------------------------------------------------------------
# Canonical application URL used for CSRF origin verification and email metadata
# - Local Development: http://localhost:3000
# - Vercel Production: https://your-production-domain.vercel.app
NEXT_PUBLIC_APP_URL=https://your-production-domain.vercel.app

# Public API URL endpoint (defaults to ${NEXT_PUBLIC_APP_URL}/api)
NEXT_PUBLIC_API_URL=https://your-production-domain.vercel.app/api

# ------------------------------------------------------------------------------
# 4. AI Provider Integration (Optional - Built-in Engine Fallback)
# ------------------------------------------------------------------------------
# OpenAI API key (or OpenAI-compatible provider like Groq, Together, Azure, or Ollama)
# If empty or if rate-limited, the application seamlessly activates its built-in
# local algorithmic ATS cover letter engine without error or interruption.
OPENAI_API_KEY=

# LLM model name (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Base URL for API calls (default: official OpenAI endpoint)
OPENAI_BASE_URL=https://api.openai.com/v1

# AI request timeout in milliseconds before triggering the local engine (default: 15000ms = 15s)
AI_REQUEST_TIMEOUT_MS=15000

# Retry attempts on transient network or 429 rate limit errors (default: 1 retry)
AI_MAX_RETRIES=1

# Maximum completion tokens per AI request
AI_RESUME_MAX_TOKENS=2500
AI_COVER_LETTER_MAX_TOKENS=1500

# Circuit Breaker configuration: trip after N consecutive failures and use fallback for cooldownMs (default: 3 failures, 60000ms = 1m)
AI_CIRCUIT_BREAKER_THRESHOLD=3
AI_CIRCUIT_BREAKER_COOLDOWN_MS=60000

# Global daily AI spend cap in USD (switches to fallback and sends Sentry + Resend alert when exceeded)
AI_DAILY_BUDGET_USD=10.00
ADMIN_ALERT_EMAIL=admin@jobmatch.ai

# Master toggle to enable or disable external AI calls (default: true)
AI_PROVIDER_ENABLED=true

# ------------------------------------------------------------------------------
# 5. Lemon Squeezy Payments (Primary International / USD)
# ------------------------------------------------------------------------------
# Allow mock payment redirects ONLY in non-production (NODE_ENV !== 'production')
# when set to 'true'. Must remain 'false' (or unset) in production.
ALLOW_MOCK_PAYMENTS=false

# Lemon Squeezy API Key from https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=replace_with_your_lemonsqueezy_api_key

# Lemon Squeezy Store ID from https://app.lemonsqueezy.com/settings/stores
LEMONSQUEEZY_STORE_ID=replace_with_your_lemonsqueezy_store_id

# Lemon Squeezy Variant IDs for JobMatch Pro Subscriptions & Pay-As-You-Go Pack
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=replace_with_lemonsqueezy_pro_monthly_variant_id
LEMONSQUEEZY_VARIANT_PRO_ANNUAL=replace_with_lemonsqueezy_pro_annual_variant_id
LEMONSQUEEZY_VARIANT_PAYG=replace_with_lemonsqueezy_payg_variant_id

# Lemon Squeezy Webhook Signing Secret for HMAC-SHA256 verification at /api/webhooks/lemonsqueezy
LEMONSQUEEZY_WEBHOOK_SECRET=replace_with_your_lemonsqueezy_webhook_secret

# ------------------------------------------------------------------------------
# 6. Stripe Payments (International / USD)
# ------------------------------------------------------------------------------
# Stripe Secret Key from https://dashboard.stripe.com/apikeys (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key

# Stripe Webhook Signing Secret (whsec_...) from dashboard or Stripe CLI
# Used to verify webhook events at /api/webhooks/payment
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret

# Stripe Publishable Key (optional client-side key)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_publishable_key

# Stripe Recurring Price IDs for JobMatch Pro Subscriptions (mode: 'subscription')
# Create recurring prices in Stripe Dashboard > Product Catalog ($9/month and $84/year)
STRIPE_PRICE_PRO_MONTHLY=price_replace_with_stripe_pro_monthly_price_id
STRIPE_PRICE_PRO_ANNUAL=price_replace_with_stripe_pro_annual_price_id

# ------------------------------------------------------------------------------
# 6. Paymob Accept (Egypt / EGP)
# ------------------------------------------------------------------------------
# Paymob API Key from https://accept.paymob.com > Settings > Account Info > API Key
PAYMOB_API_KEY=replace_with_your_paymob_api_key

# Paymob Integration ID for Card / Mobile Wallet payments
PAYMOB_INTEGRATION_ID=123456

# Paymob HMAC Secret for SHA512 transaction callback verification
PAYMOB_HMAC_SECRET=replace_with_your_paymob_hmac_secret

# Paymob Iframe ID to display the card entry UI
PAYMOB_IFRAME_ID=123456

# ------------------------------------------------------------------------------
# 7. Resend Transactional Email (Verified Project Domain: SPF / DKIM / DMARC)
# ------------------------------------------------------------------------------
# Resend API Key from https://resend.com/api-keys (re_...)
# If not configured, email delivery is safely simulated in console logs for testing.
# See docs/EMAIL_SETUP.md for full SPF/DKIM/DMARC domain verification steps.
RESEND_API_KEY=re_replace_with_your_resend_api_key

# Sender email address verified on your project domain (NEVER use @gmail.com / @yahoo.com)
EMAIL_FROM="JobMatch AI <noreply@jobmatch.ai>"

# Official support email on the verified project domain
SUPPORT_EMAIL=support@jobmatch.ai

# Optional base backoff delay (ms) for the non-blocking email retry queue
EMAIL_RETRY_BASE_MS=1500

# ------------------------------------------------------------------------------
# 8. Sentry Error Monitoring & APM
# ------------------------------------------------------------------------------
# Sentry DSN from https://sentry.io > Project Settings > Client Keys (DSN)
# Active only in production; all personal data, resumes, emails, and tokens are scrubbed.
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Optional Sentry build-time source map upload configuration
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=jobmatch-ai
SENTRY_AUTH_TOKEN=sntrys_replace_with_sentry_auth_token

# ------------------------------------------------------------------------------
# 9. PostHog Product & Conversion Funnel Analytics
# ------------------------------------------------------------------------------
# PostHog Project API Key from https://us.i.posthog.com or https://eu.i.posthog.com
# Only initialized after user accepts the Cookie/Analytics Consent Banner.
# Tracks privacy-friendly conversion events without any resume or personal text.
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_with_your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------------------------------
# 10. Upstash Redis Distributed Sliding-Window Rate Limiting
# ------------------------------------------------------------------------------
# Upstash Redis REST URL and Token from https://console.upstash.com
# If not configured in production, logs a warning and falls back to MongoDB TTL collection.
UPSTASH_REDIS_REST_URL=https://replace_with_your_upstash_redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_your_upstash_redis_rest_token

