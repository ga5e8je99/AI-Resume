{
  "build": {
    "env": {
      "NEXT_TURBOPACK": "0"
    }
  },
  "functions": {
    "app/api/cover-letter/generate/route.ts": {
      "maxDuration": 60
    },
    "app/api/resume/generate/route.ts": {
      "maxDuration": 60
    },
    "app/api/jobs/search/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/job-alerts",
      "schedule": "0 8 * * *"
    }
  ]
}
